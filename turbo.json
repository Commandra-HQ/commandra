{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"],
			"passThroughEnv": [
				"SENTRY_AUTH_TOKEN",
				"SENTRY_ORG",
				"SENTRY_PROJECT",
				"SENTRY_DSN",
				"NEXT_PUBLIC_SENTRY_DSN",
				"SENTRY_ENVIRONMENT"
			]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"lint": {
			"dependsOn": ["^build"]
		},
		"clean": {
			"cache": false
		},
		"db:generate": {
			"cache": false
		},
		"db:migrate": {
			"cache": false
		},
		"test": {
			"dependsOn": ["^build"],
			"cache": false
		}
	}
}
