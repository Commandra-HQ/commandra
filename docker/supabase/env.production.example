# Copy this block into docker/supabase/.env for PRODUCTION (db.commandra.app).
# Generate the rest with: sh ./utils/generate-keys.sh --update-env
# Then set these overrides and DISABLE_SIGNUP / ENABLE_*_SIGNUP as below.

# ---------- URLs (production) ----------
SUPABASE_PUBLIC_URL=https://db.commandra.app
API_EXTERNAL_URL=https://db.commandra.app
SITE_URL=https://app.commandra.app

# ---------- Identity (set your own) ----------
POOLER_TENANT_ID=commandra
DASHBOARD_USERNAME=admin
# DASHBOARD_PASSWORD= set by generate-keys.sh; change to a password you will remember

# ---------- Auth disabled (Commandra uses its own auth) ----------
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=false
ENABLE_PHONE_SIGNUP=false
ENABLE_ANONYMOUS_USERS=false
