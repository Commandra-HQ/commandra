# LLM Provider (anthropic or openai)
LLM_PROVIDER=anthropic
LLM_API_KEY=sk-ant-...
LLM_MODEL_STRONG=sonnet
LLM_MODEL_FAST=haiku

# For OpenAI provider, use:
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL_STRONG=gpt-4o
# LLM_MODEL_FAST=gpt-4o-mini

# Database: connect to self-hosted Supabase (see docs/supabase-local.md).
# POSTGRES_PASSWORD and POOLER_TENANT_ID come from docker/supabase/.env.
# Local dev (Supabase on host): use localhost and Supavisor port (default 5432).
# Commandra in Docker + Supabase on host: use host.docker.internal (see docker-compose.dev.yml).
# DATABASE_URL=postgresql://postgres.POOLER_TENANT_ID:POSTGRES_PASSWORD@localhost:5432/postgres
DATABASE_URL=postgresql://postgres.your-tenant-id:YOUR_POSTGRES_PASSWORD@localhost:5432/postgres

# Server
PORT=3001
WS_PORT=3002

# Dashboard URL (used by the Chrome extension to link to the web dashboard)
DASHBOARD_URL=http://localhost:3000

# CORS: comma-separated origins to allow (e.g. dashboard URL in production)
# chrome-extension:// and http://localhost:* are always allowed
# CORS_ORIGINS=https://app.yourdomain.com

# JWT secret for auth (generate with: openssl rand -base64 32)
JWT_SECRET=generate-a-random-secret-here

# Sentry (optional — set in production to capture errors)
# Create three projects in Sentry (API, dashboard, extension) and use each DSN where noted.
# API (Node)
# SENTRY_DSN=https://...@....ingest.sentry.io/...
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Dashboard (Next.js) — also set in the web app env / hosting (NEXT_PUBLIC_* is exposed to the browser)
# SENTRY_DSN=https://...@....ingest.sentry.io/...
# NEXT_PUBLIC_SENTRY_DSN=https://...@....ingest.sentry.io/...
# SENTRY_ENVIRONMENT=production
# Optional: upload source maps on `next build` (CI)
# SENTRY_AUTH_TOKEN=...
# SENTRY_ORG=your-org
# SENTRY_PROJECT=commandra-dashboard

# Chrome extension (Vite) — prefix with VITE_ for build-time embedding
# VITE_SENTRY_DSN=https://...@....ingest.sentry.io/...

# Supabase (for agent file storage — uses the same Supabase instance as the database)
# IMPORTANT: SUPABASE_SERVICE_ROLE_KEY must be signed with the same JWT_SECRET used by Supabase containers.
# If using docker/supabase/, ensure JWT_SECRET in docker/supabase/.env matches JWT_SECRET here,
# then generate keys with: node -e "..." or use docker/supabase/utils/generate-keys.sh
SUPABASE_URL=http://localhost:8000
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# SYNC_SECRET
SYNC_SECRET=example

# Marketing site (extension “goodbye” tab / uninstall uses LANDING_URL + /goodbye unless GOODBYE_URL is set)
# LANDING_URL=http://localhost:3003
# GOODBYE_URL=https://commandra.app/goodbye
LANDING_URL=example