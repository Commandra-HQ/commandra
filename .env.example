# LLM Provider (anthropic or openai)
LLM_PROVIDER=anthropic
LLM_API_KEY=sk-ant-...
LLM_MODEL_STRONG=sonnet
LLM_MODEL_FAST=haiku

# For OpenAI provider, use:
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL_STRONG=gpt-4o
# LLM_MODEL_FAST=gpt-4o-mini

# Database (defaults work with docker compose)
DATABASE_URL=postgresql://afe:afe_dev@localhost:5433/afe

# Server
PORT=3001
WS_PORT=3002

# Auth provider: jwt (default, self-hosted) or clerk (cloud)
AUTH_PROVIDER=jwt

# JWT auth (for AUTH_PROVIDER=jwt — self-hosted default)
JWT_SECRET=generate-a-random-secret-here

# Clerk auth (for AUTH_PROVIDER=clerk — cloud only)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# Optional: OpenAI embeddings
# OPENAI_API_KEY=sk-...

# Optional: Voyage AI embeddings (falls back to local)
# VOYAGE_API_KEY=
