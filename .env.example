# LLM Provider (anthropic or openai)
LLM_PROVIDER=anthropic
LLM_API_KEY=sk-ant-...
LLM_MODEL_STRONG=sonnet
LLM_MODEL_FAST=haiku

# Legacy fallback — used if LLM_API_KEY is not set and LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# For OpenAI provider, use:
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL_STRONG=gpt-4o
# LLM_MODEL_FAST=gpt-4o-mini

# Database (defaults work with docker compose)
DATABASE_URL=postgresql://afe:afe_dev@localhost:5433/afe

# Server
PORT=3001
WS_PORT=3002

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Extension JWT (long-lived tokens for the Chrome extension)
JWT_SECRET=generate-a-random-secret-here

# Inngest
INNGEST_EVENT_KEY=local
INNGEST_SIGNING_KEY=local

# Optional: Voyage AI embeddings (falls back to local)
# VOYAGE_API_KEY=
