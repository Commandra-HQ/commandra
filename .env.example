# LLM Provider (anthropic or openai)
LLM_PROVIDER=anthropic
LLM_API_KEY=sk-ant-...
LLM_MODEL_STRONG=sonnet
LLM_MODEL_FAST=haiku

# For OpenAI provider, use:
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL_STRONG=gpt-4o
# LLM_MODEL_FAST=gpt-4o-mini

# Database (defaults work with docker compose)
DATABASE_URL=postgresql://afe:afe_dev@localhost:5433/afe

# Server
PORT=3001
WS_PORT=3002

# CORS: comma-separated origins to allow (e.g. dashboard URL in production)
# chrome-extension:// and http://localhost:* are always allowed
# CORS_ORIGINS=https://app.yourdomain.com

# JWT secret for auth (generate with: openssl rand -base64 32)
JWT_SECRET=generate-a-random-secret-here

# Embeddings (auto-detected from LLM_PROVIDER if EMBEDDING_PROVIDER is not set)
# Supported: voyage (default for anthropic), openai (default for openai), ollama
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3.5
EMBEDDING_API_KEY=pa-...
# For OpenAI embeddings, EMBEDDING_API_KEY can be your same OpenAI key (reuses LLM_API_KEY if not set)
# For Ollama, no key needed
